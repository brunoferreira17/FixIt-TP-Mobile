<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.FixIt" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Cores ajustadas para o botão azul -->
        <item name="colorPrimary">#2199F9</item> <!-- azul real -->
        <item name="colorPrimaryVariant">#1976D2</item> <!-- tom mais escuro -->
        <item name="colorOnPrimary">#FFFFFF</item>

        <item name="colorSecondary">#2199F9</item>
        <item name="colorOnSecondary">#FFFFFF</item>

        <!-- Fundo da app -->
        <item name="android:windowBackground">@color/light_blue</item>

        <!-- Permitir modo escuro -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">true</item>
    </style>

    <style name="CircularImageView">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>
